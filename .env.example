# Developer Portal → your application → General Information → Application ID
DISCORD_APPLICATION_ID=
# Developer Portal → your application → General Information → Public Key
DISCORD_PUBLIC_KEY=
# Developer Portal → your application → Bot → Reset Token (shown once; keep it secret)
DISCORD_BOT_TOKEN=
# Optional: register the command in one server only (instant). Enable Developer Mode in Discord, then right-click the server → Copy Server ID
# DISCORD_GUILD_ID=
